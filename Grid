import turtle as t

def draw_grid():
    t.speed(0)      # 그리기 속도 가장 빠르게
    t.color("gray") # 격자선 색상
    
    # 윈도우 크기에 맞게 격자 간격과 범위 설정
    size = 50       # 격자 한 칸의 크기
    screen_size = 300
    
    # 세로줄 그리기
    for x in range(-screen_size, screen_size + 1, size):
        t.penup()
        t.goto(x, -screen_size)
        t.pendown()
        t.goto(x, screen_size)
        
    # 가로줄 그리기
    for y in range(-screen_size, screen_size + 1, size):
        t.penup()
        t.goto(-screen_size, y)
 
